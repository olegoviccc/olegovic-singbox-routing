{
  "name": "Bypass Russia",
  "description": "Everything through the proxy except Russian sites/IPs, which go direct. Ads are blocked.",
  "final": "proxy",
  "rules": [
    {
      "outbound": "block",
      "geosite": ["category-ads-all"]
    },
    {
      "outbound": "direct",
      "geosite": ["category-ru", "ru-available-only-inside"],
      "geoip": ["ru"],
      "domain_suffix": ["ru", "su", "xn--p1ai"]
    }
  ]
}
