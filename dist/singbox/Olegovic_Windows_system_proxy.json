        ],
        "action": "route",
        "outbound": "direct"
      },
      {
        "network": "udp",
        "port": [
          443
        ],
        "action": "reject"
      },
      {
        "domain_suffix": [
          "aur.archlinux.org"
        ],
        "rule_set": [
          "geosite-ru-blocked",
