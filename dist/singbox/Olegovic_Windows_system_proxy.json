      },
      {
        "rule_set": [
          "geosite-category-ads-all"
        ],
        "action": "reject"
      },
      {
        "protocol": "bittorrent",
        "action": "route",
        "outbound": "direct"
      },
      {
        "process_name": [
          "qbittorrent.exe"
        ],
        "action": "route",
        "outbound": "direct"
      },
      {
        "rule_set": [
          "geosite-telegram",
