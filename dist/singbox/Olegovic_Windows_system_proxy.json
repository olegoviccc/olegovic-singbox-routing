          "Agent.exe"
        ],
        "action": "route",
        "outbound": "direct"
      },
      {
        "process_path_regex": [
          "(?i)\\\\Steam\\\\",
          "(?i)\\\\steamapps\\\\",
          "(?i)\\\\Battle\\.net\\\\",
