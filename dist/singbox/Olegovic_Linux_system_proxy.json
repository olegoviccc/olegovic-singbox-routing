          "discord",
          "Telegram",
          "telegram-desktop"
        ],
        "action": "route",
        "outbound": "proxy"
      },
      {
        "rule_set": [
          "geosite-steam",
          "geosite-blizzard"
        ],
        "action": "route",
        "outbound": "direct"
      },
      {
        "process_name": [
