        "action": "route",
        "outbound": "direct"
      },
      {
        "process_name": [
          "qbittorrent",
          "qbittorrent-nox"
        ],
        "action": "route",
        "outbound": "direct"
      },
      {
        "rule_set": [
          "geosite-telegram",
          "geosite-discord",
          "geosite-whatsapp",
          "geoip-telegram"
        ],
        "action": "route",
        "outbound": "proxy"
      },
      {
        "process_name": [
