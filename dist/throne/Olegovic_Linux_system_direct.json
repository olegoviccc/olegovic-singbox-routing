[
  {
    "protocol": "dns",
    "action": "hijack-dns"
  },
  {
    "ip_is_private": true,
    "action": "route",
    "outbound": "direct"
  },
  {
    "ip_version": 6,
    "action": "reject"
  },
  {
    "rule_set": [
      "geosite-category-ads-all"
    ],
    "action": "reject"
  },
  {
    "protocol": "bittorrent",
    "action": "route",
    "outbound": "direct"
  },
  {
    "process_name": [
      "qbittorrent",
      "qbittorrent-nox"
    ],
    "action": "route",
    "outbound": "direct"
  },
  {
    "rule_set": [
      "geosite-telegram",
      "geosite-discord",
      "geosite-whatsapp",
      "geoip-telegram"
    ],
    "action": "route",
    "outbound": "proxy"
  },
  {
    "process_name": [
      "Discord",
      "discord",
      "Telegram",
      "telegram-desktop"
    ],
    "action": "route",
    "outbound": "proxy"
  },
  {
    "rule_set": [
      "geosite-steam",
      "geosite-blizzard"
    ],
    "action": "route",
    "outbound": "direct"
  },
  {
    "process_name": [
      "steam",
      "steamwebhelper",
      "reaper",
      "pressure-vessel-wrap",
      "wine",
      "wine64",
      "wine-preloader",
      "wine64-preloader",
      "wineserver",
      "umu-run",
      "faugus-launcher",
      "lutris"
    ],
    "action": "route",
    "outbound": "direct"
  },
  {
    "process_path_regex": [
      "/\\.local/share/Steam/",
      "/\\.steam/",
      "/com\\.valvesoftware\\.Steam/",
      "/steamapps/",
      "/compatibilitytools\\.d/",
      "/\\.local/share/umu/",
      "/\\.local/share/lutris/",
      "/\\.local/share/faugus-launcher/",
      "/\\.config/faugus-launcher/",
      "/Faugus/",
      "/Games/",
      "^/usr/lib/steam/",
      "^/usr/(lib|lib32|share)/wine/"
    ],
    "action": "route",
    "outbound": "direct"
  },
  {
    "network": "udp",
    "port": [
      443
    ],
    "action": "reject"
  },
  {
    "domain_suffix": [
      "aur.archlinux.org"
    ],
    "rule_set": [
      "geosite-ru-blocked",
      "geosite-youtube",
      "geosite-roblox",
      "geosite-category-ai-!cn",
      "geosite-github",
      "geosite-docker",
      "geosite-npmjs",
      "geosite-jetbrains",
      "geosite-notion",
      "geosite-nvidia",
      "geosite-intel",
      "geosite-spotify",
      "geoip-ru-blocked"
    ],
    "action": "route",
    "outbound": "proxy"
  },
  {
    "rule_set": [
      "geosite-ru-available-only-inside"
    ],
    "action": "route",
    "outbound": "direct"
  },
  {
    "process_name": [
      "konsole",
      "yakuake",
      "kitty",
      "alacritty",
      "ghostty",
      "wezterm",
      "wezterm-gui",
      "foot",
      "footclient",
      "gnome-terminal-server",
      "kgx",
      "ptyxis",
      "tilix",
      "terminator",
      "xfce4-terminal",
      "qterminal",
      "lxterminal",
      "xterm",
      "urxvt",
      "st",
      "rio",
      "contour",
      "warp",
      "bash",
      "zsh",
      "fish",
      "sh",
      "nu",
      "curl",
      "wget",
      "wget2",
      "aria2c",
      "git",
      "git-remote-http",
      "git-remote-https",
      "ssh",
      "scp",
      "sftp",
      "rsync",
      "pacman",
      "paru",
      "yay",
      "pikaur",
      "flatpak",
      "fwupd",
      "fwupdmgr",
      "packagekitd",
      "pkcon",
      "rate-mirrors",
      "shelly",
      "Shelly",
      "plasmashell",
      "kwin_wayland",
      "kwin_x11",
      "kded6",
      "kded5",
      "ksmserver",
      "krunner",
      "dolphin",
      "systemsettings",
      "plasma-discover",
      "kdeconnectd",
      "kioworker",
      "baloo_file",
      "spectacle",
      "kwalletd6",
      "drkonqi",
      "NetworkManager",
      "systemd-resolved",
      "systemd-timesyncd",
      "avahi-daemon",
      "cupsd",
      "dockerd",
      "containerd",
      "docker",
      "podman"
    ],
    "action": "route",
    "outbound": "direct"
  },
  {
    "process_path_regex": [
      "^/usr/lib/kf6/",
      "^/usr/lib/kf5/",
      "^/usr/lib/libexec/",
      "^/usr/lib/systemd/",
      "^/usr/lib/packagekit",
      "(?i)/shelly"
    ],
    "action": "route",
    "outbound": "direct"
  },
  {
    "domain_suffix": [
      "ru",
      "su",
      "xn--p1ai"
    ],
    "rule_set": [
      "geosite-category-ru",
      "geoip-ru"
    ],
    "action": "route",
    "outbound": "direct"
  }
]
